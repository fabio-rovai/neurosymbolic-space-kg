    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">An Orbital System is a dynamic physical system in which one or more masses orbits the systems barycenter.</dc:description>
    <rdfs:comment xml:lang="en">A category whose instances are a composite physical system composed of at least two mass orbiting a common center of gravity.</rdfs:comment>
    <rdfs:label xml:lang="en">Orbital System</rdfs:label>
    <ns1:Example xml:lang="en">The Earth-Moon system. Earth's solar system.</ns1:Example>
  </rdf:Description>
