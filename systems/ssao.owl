  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Weather_Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Astronomical_Event"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A naturally occuring event involving space weather phenomena.

A naturally occuring event in the inter- and intra- planetary and stellar environments.

A naturally occuring event in the inter- and intra- planetary and stellar environments, involving space weather phenomena.</dc:description>
    <rdfs:label xml:lang="en">space weather event</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Space Weather Event</ns1:Alternative_Label>
    <ns1:Example xml:lang="en">Coronal mass ejection</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Keepout_Distance_value">
