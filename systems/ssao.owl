  <rdf:Description rdf:about="https://purl.org/space-ontology/Interplanetary_Mission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Mission"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Interplanetary Mission</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Reference_Origin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Geometric_Reference_Entity"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">An origin (either a mathematical or physical point) used as a reference point in defining or fixing a coordinate system.</rdfs:comment>
    <rdfs:label xml:lang="en">Reference Origin</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Debris">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Object"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">Natural or artificial objects located in outer space, and which are not usable or do not have a function...

A natural or artifiical physical object in space that, by virtue of some event or process, has lost its function, or has ceased to be a functional or structural part of its whole.</dc:description>
    <dc:source xml:lang="en">This class is in the Orbital Debris Ontology (ODO) by Rovetto. See publication [1].</dc:source>
    <rdfs:label xml:lang="en">space debris object</rdfs:label>
    <rdfs:seeAlso xml:lang="en">https://arxiv.org/abs/1704.01014</rdfs:seeAlso>
    <rdfs:seeAlso xml:lang="en">https://link.springer.com/article/10.1007/s12145-015-0233-3</rdfs:seeAlso>
    <ns1:Alternative_Label xml:lang="en">space debris</ns1:Alternative_Label>
    <ns1:Clarifying_Note xml:lang="en">Space Debris is differentiated from Orbital Debris because not all space debris are necessarily in an orbit.</ns1:Clarifying_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Disclaimer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Disclaimer</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Astronomical_Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">An astronomical event is a naturally-occurring event in astronomical space (i.e., outer space, or the microgravity environment) involving astonomical bodies.</dc:description>
    <rdfs:comment xml:lang="en">A naturally-occurring event in which astronomical bodies participate.

Where key terms, e.g., 'event', 'participate', etc. are asserted and also defined.</rdfs:comment>
    <rdfs:comment xml:lang="en">This is a category for the various kinds of naturally-occurring events in astronomical space.</rdfs:comment>
    <rdfs:label xml:lang="en">astronomical event</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Astronomical Event</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Purpose_of_Spacecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">Purpose</rdfs:label>
    <ns1:Clarifying_Note xml:lang="en">The purpose of an artificial satellite is often provided (documented) by the satellite operator or owner.</ns1:Clarifying_Note>
    <ns1:Description_of_Class xml:lang="en">This class is intended to categorize the purposes a spacecraft may have (modeled as sub-categories).</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Distinguish with function.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space-based_Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Artificial_Sensor"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A sensor that resides and is designed to operate in the microgravity environment of outer space.</dc:description>
    <rdfs:label xml:lang="en">Space-based Sensor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Sol">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/space-ontology/Star"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The central star of Earth's solar system, also referred to in English as "the sun".</dc:description>
    <rdfs:label xml:lang="en">Sol</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">The Sun</ns1:Alternative_Label>
    <ns1:IRI_UUID_Shortname xml:lang="en">819392f7_085e_469b_9d00_df52f4aa7080</ns1:IRI_UUID_Shortname>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbiting_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Physical_Process"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A process in which an object orbits a center of gravity.</dc:description>
    <rdfs:label xml:lang="en">Orbiting Process</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">orbit process</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">orbiting process</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">This is part of the ongoing conoceptual analysis and development of the orbital concepts. For example, an orbit can be characterized as an occuring activity or process, rather than a thing. In other words, we can ontologically describe orbital motion instead of, or in addition to, desribing an orbit.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/describes_at_time">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">describes at time</rdfs:label>
    <ns1:Example_of_Usage xml:lang="en">The Classical Keplerian Orbital Elements describe at time an orbit.</ns1:Example_of_Usage>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Civil_User">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/User"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">civil user</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Sensor_Tasking_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Process"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">sensor tasking process</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Plane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Geometric_Entity"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The two-dimensional plane upon which the path of an orbiting object is projected in order to help desrcibe the objects orbit and motion.</dc:description>
    <rdfs:label xml:lang="en">orbital plane</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Orbital Plane</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development. Various modeling approaches.</ns1:Development_Status_Note>
    <ns1:Editor xml:lang="en">Robert J. Rovetto</ns1:Editor>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Natural_Satellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Satellite"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Natural Satellite</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Subclasses, e.g., Moon, may be imported from an astronomy ontology.</ns1:Development_Status_Note>
    <ns1:Natural_Language_Definition_of_Label xml:lang="en">a satellite that was not created by human beings.
a satellite that was created by natural processes.
a naturally-created satellite.</ns1:Natural_Language_Definition_of_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_social_role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">A generic relation relating a person, agent, or actor and a social role they have or play during a period of time or in a set of circumstances.</rdfs:comment>
    <rdfs:label xml:lang="en">has social role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_Payload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft_Part"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The payload of a spacecraft.</dc:description>
    <rdfs:label xml:lang="en">Spacecraft Payload</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">The term "payload" in the astronautical community is used in relation to spacecraft and launch vehicles. However, the term itself is not specific to the domain of astronautics. Therefore consider it as a label for the broadest sense. There are other terms that reflect a similar situations--the context-specific meaninig is more narrow than the term, i.e., the term can be applied in different contexts without loss of meaninig by readers. 

Will this--using the label "Payload" for the broadest sense be problematic?</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_Part">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A spacecraft part is a part of a spacecraft, and may include spacecraft subsystems or components thereof.</dc:description>
    <rdfs:label xml:lang="en">Spacecraft Part</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">R.J.Rovetto's Spacecraft Ontology.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/detects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">A relationship between a sensor and an object, whereby the latter is detected by the former.</rdfs:comment>
    <rdfs:label xml:lang="en">detects</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/2D_Plane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Geometric_Entity"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">A two-dimensional surface</rdfs:comment>
    <rdfs:label xml:lang="en">two-dimensional plane</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">2-D plane</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">2D plane</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Two-dimensional Plane</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">two-dimensional geometric plane</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Earth_Observing_Satellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Artificial_Satellite"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">An Aritifial Satellite that has an Earth-observing purpose, function, or capacity.
An artificial satellite whose primary mission is Earth-observation.
An artificial satellite designed for Earth-observation.

An artificial satellite with an instrument for Earth-observation.</rdfs:comment>
    <rdfs:label xml:lang="en">Earth Observing Satelltie</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/IRI_short_name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">This annotation displays the IRI fragment for the ontology entity in question, e.g., global universal identifier (unique universal ID) or alphanumeric ID.</rdfs:comment>
    <rdfs:comment xml:lang="en">may be similar to skos:prefLabel</rdfs:comment>
    <rdfs:label xml:lang="en">IRI short name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/is_cause_of">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">is cause of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Orbital_Parameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://purl.org/space-ontology/has_Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has orbital parameter</rdfs:label>
  </rdf:Description>
