  <rdf:Description rdf:about="https://purl.org/space-ontology/Medium_Earth_Orbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Geocentric_Orbit"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A MEO is an Earth Orbit from approximately 3000 km to approximately 35856 km (Geosynchronous Orbit)</dc:description>
    <rdfs:comment xml:lang="en">Medium Earth Orbit more precisely designates a range of possible orbits within a specified distance range (e.g., 2000 to 35856 km) from a the Earth. For this reason, the term 'regime' may be used.</rdfs:comment>
    <rdfs:label xml:lang="en">Medium Earth Orbit</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">MEO</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Mid Earth Orbit</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">sensor</rdfs:label>
    <ns1:Clarifying_Note xml:lang="en">The concept of 'sensor' is broad (e.g., organic and tehnological sensors). In the context of SSA the term is used to more specifically signify technological sensors.</ns1:Clarifying_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Commercial_User">
