    <dc:description xml:lang="en">This class represents the objects of study in the discipline of Astronomy.
Examples: planets, stars, moons, etc.</dc:description>
    <rdfs:label xml:lang="en">Astronomical Object</rdfs:label>
    <skos:altLabel xml:lang="en">astronomical body</skos:altLabel>
    <ns1:Alternative_Label xml:lang="en">Astronomical Body</ns1:Alternative_Label>
