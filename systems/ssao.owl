  <rdf:Description rdf:about="http://www.semanticweb.org/rrovetto/ontologies/2014/space-situational-awareness-ontology#has_orbital_eccentricity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:range rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb1"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">This data property is a binary predicate expressing the eccentricity of the orbit of an object in its orbit at a particular time.

An orbit can have only one eccentricity at a time for a given time.

The possible values of orbital eccentricty range from 0 to 1, and therefore this data property can have the same decimal value range.</dc:description>
    <dc:description>This data property represents a binary relation expressing the eccentricity of an orbiting object in its orbit at a particular time</dc:description>
    <rdfs:label xml:lang="en">has_orbital_eccentricity</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">has orbit eccentricity value</ns1:Alternative_Label>
  </rdf:Description>
