  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Debris">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Debris"/>
    <dc:creator xml:lang="en">Robert J. Rovetto</dc:creator>
    <dc:description xml:lang="en">Debris located in orbit around a central body.</dc:description>
    <rdfs:label xml:lang="en">Orbital Debris</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://github.com/rrovetto/The-Orbital-Debris-Ontology"/>
    <rdfs:seeAlso xml:lang="en">https://arxiv.org/abs/1704.01014</rdfs:seeAlso>
    <rdfs:seeAlso xml:lang="en">https://link.springer.com/article/10.1007/s12145-015-0233-3</rdfs:seeAlso>
    <ns1:Alternative_Label xml:lang="en">Orbital Debris Object</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Orbital Space Debris</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Orbital Space Debris Object</ns1:Alternative_Label>
    <ns1:Description_of_Class xml:lang="en">This class is intended to categorize orbital space debris objects. It is subdivided into subclasses for each kind of orbital debris, such as fragmentation debris.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">The Orbital Debris Ontology (ODO) [1] by R.J.Rovetto, which presents a taxonomy and ontology of types of debris, their characteristics, and mitigation &amp; remediation methods.

[1], "An Ontological Architecture for Orbital Debris Data" (Rovetto, R.J. 6 Aug 2015, Earth Science Informatics).</ns1:Development_Status_Note>
  </rdf:Description>
