    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbital_Property"/>
    <dc:creator xml:lang="en">Robert J. Rovetto</dc:creator>
    <dc:description xml:lang="en">A specified point in time. The temporal reference frame.
The time at which the elements (a particular set) was taken/acquired.</dc:description>
    <rdfs:label xml:lang="en">epoch</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb59">
    <rdfs:comment xml:lang="en">This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/is_controlled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">This Data Property (relatiion) is intended to express whether an object is in controlled motion or flight. This is a particular concern for the orbital debris domain.</rdfs:comment>
    <rdfs:label xml:lang="en">is controlled</rdfs:label>
  </rdf:Description>
