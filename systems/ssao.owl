  <rdf:Description rdf:about="https://purl.org/space-ontology/Spaceflight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The activity or process of flying in the microgravity environment of outerspace (or astronomical space).
The controlled motion of a spacecraft in outerspace.</dc:description>
    <rdfs:label xml:lang="en">spaceflight</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/U.S._SSN">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/space-ontology/SSA_Network"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The United States Space Surveillance Network (SSN)</dc:description>
    <dc:description xml:lang="en">The sensors in the SSN are categories as Collateral, Contributing, and Dedicated Sensors.</dc:description>
    <rdfs:label xml:lang="en">United State Space Surveillance Network</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">SSN</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_Operations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">Spacecraft operations are operations (activities) performed by spacecraft, either autonomously or via commands from an external agent (e.g., from a person located in a ground control station). An operation executed by a spacecraft autonomously or by command from an external agent.</rdfs:comment>
    <rdfs:label xml:lang="en">spacecraft operations</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Disambiguate: Spacecraft Operation vs. Operations. 
The set of activities to operate a spacecraft may be described by the category of Spacecraft Command Operations. And the resultant set of activities that the spacecraft itself performs (e.g. maneuvers, signal processes, calibration, etc.) can be described by the category of Spacecraft Operations.</ns1:Development_Status_Note>
  </rdf:Description>
