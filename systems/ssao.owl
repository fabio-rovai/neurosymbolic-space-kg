    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An actor (person, group, organization, agency, government, nation-state, etc.) engaging in SSA activities or using SSA services or data</dc:description>
    <rdfs:label xml:lang="en">SSA Actor</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">SSA Agent</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">A temporary class to group actors or agents performing or participating in SSA activities, using SSA services or data.</ns1:Development_Status_Note>
    <ns1:Development_Status_Note xml:lang="en">More generally, activities are deliberate occurrences or processes in which actors (or agents) engage. Actors (or agents) enact or participate in activities.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Metric_Data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Data"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">Metric Data in SSA is data about the position of an object. It includes azimuth, elevation, range, range rate, and time.</dc:description>
    <rdfs:label xml:lang="en">Metric Data</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Unit_of_Measure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has Unit of Measure</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Declination_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">May be value of longitude.</rdfs:comment>
    <rdfs:label xml:lang="en">has declination value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Metric_Obervation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Sensor_Observation"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">metric observation</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Can distinguish between the metric observation and the metric data. The former would involve or result in the latter: the observing activities yields a data set.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Perigee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The closest distance, in an orbit, from the surface of the Earth</dc:description>
    <rdfs:label xml:lang="en">Perigee</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/JAXA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/space-ontology/Space_Agency"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">JAXA</rdfs:label>
    <ns1:IRI_UUID_Shortname>08fd1df8_1806_4a81_af9c_f9deb53d0f7a</ns1:IRI_UUID_Shortname>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Ground_Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Mission_Segment"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The Ground Segment is the collection of ground-based facilities, hardware, software and human resources required to manage and control a spacecraft or space mission.</dc:description>
    <rdfs:comment xml:lang="en">A spacecraft mission, and the outerspace domain in general, is often described in terms of segments: the ground segment, control segment, launch segment, space segment, user segment, etc. Each represents a grouping of sysetms, activities, and personnel that form part of, and help execute the mission or operate the SSA system.</rdfs:comment>
    <rdfs:label xml:lang="en">Ground Segment</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">This is a tentative category for the collection of those facilities, activities, data, systems and personnel on the ground which support a space mission, SSA system, spacecraft, or space segment.</ns1:Description_of_Class>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Artificial_Space_Object">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Object"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A space object that was created by human beings.
A space object that was created by agents or by non-natural processes.</dc:description>
    <rdfs:label xml:lang="en">Artificial Space Object</rdfs:label>
    <rdfs:seeAlso xml:lang="en">https://philpapers.org/archive/ROVSOO.pdf</rdfs:seeAlso>
    <ns1:Alternative_Label xml:lang="en">Astronautical Object</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Space Artefact</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Space Artifact</ns1:Alternative_Label>
    <ns1:Example xml:lang="en">The International Space Station</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://purl.org/space-ontology/Spacecraft"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">The relationship between a spacecraft or launch vehicle and its operator</rdfs:comment>
    <rdfs:label xml:lang="en">has operator</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Consider time-qualifying aspects for scenarios where a spacecraft may have distinct operators and different tmes.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Tracking_Station">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Facility"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">tracking station</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Data_Source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The origins of a data set, data element, or database.</dc:description>
    <rdfs:comment xml:lang="en">This is a type of provenance data. In the context of space situational awareness, it is important to  know the source of data and associated information, in part, to understand the quality of the data and to compare that date with other sources toward achieving accurate and actionable SSA.</rdfs:comment>
    <rdfs:label xml:lang="en">data source</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Source of Orbital Data</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development. Disambiguate from the category of Data Provider. Data Provider as an agent (e.g., an owner of a sensor) providing the data, and Data Source as the device gathering the raw data.</ns1:Development_Status_Note>
    <ns1:Editor xml:lang="en">Robert J. Rovetto</ns1:Editor>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_part">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <owl:inverseOf rdf:resource="https://purl.org/space-ontology/is_part_of"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has part</rdfs:label>
  </rdf:Description>
