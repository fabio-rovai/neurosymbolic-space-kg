  <rdf:Description rdf:about="https://purl.org/space-ontology/COSPAR_Number">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Identifier"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">COSPAR numbers are international designations assigned by the Committee on Space Research (COSPAR) to each object launched into space.

Alternative names for this includes: International Designator, NSSDC ID.</dc:description>
    <rdfs:label xml:lang="en">COSPAR number</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">COSPAR ID</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">COSPAR Identifier</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Coordinate_System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Reference_Entity"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">A coordinate system is specified on a given reference frame in order to determine position and motion of an object. Coordinate systems are composed of an origin point which is the intersectioon of three orthogonal axes.</rdfs:comment>
    <rdfs:label xml:lang="en">Coordinate System</rdfs:label>
    <ns1:Clarifying_Note xml:lang="en">Coordinate systems are necessary to specify space object position.</ns1:Clarifying_Note>
    <ns1:Natural_Language_Definition_of_Label xml:lang="en">A system of coordinates to identify the position of a point, object, or direction.</ns1:Natural_Language_Definition_of_Label>
  </rdf:Description>
