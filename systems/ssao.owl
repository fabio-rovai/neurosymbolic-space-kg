  <rdf:Description rdf:about="https://purl.org/space-ontology/Near-space_Environment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Environment"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">'Near-space' is intended to express a genearlization of near-Earth space. It is intended to be planet-neutral.</rdfs:comment>
    <rdfs:label xml:lang="en">near-space environment</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Research and develop a rule for identifying the range (distance) of the near-space environment for any given celestial body.</ns1:Development_Status_Note>
  </rdf:Description>
