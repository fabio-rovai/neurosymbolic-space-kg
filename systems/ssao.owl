    <rdfs:label xml:lang="en">SSA Facility</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">This class is a tentative grouping for facilities or physical infrastructure used for SSA. Examples include ground stations, command and control stations, tracking stations, data processing facilities, sensors facilities exclusively dedicated to SSA, etc.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Highly_Elliptical_Orbit">
