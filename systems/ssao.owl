  <rdf:Description rdf:about="https://purl.org/space-ontology/Astronautical_Craft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A craft or artificial system designed for spaceflight.
A craft or artificial system designed to operate in microgravity environments.</dc:description>
    <rdfs:label xml:lang="en">Astronautical Craft</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">This is a class intended to be about kinds of engineered systems specifically (or exclusively) designed to operate in space. This would encompass vehicles for transporting persons, cargo; unmanned spacecraft, etc.</ns1:Description_of_Class>
  </rdf:Description>
