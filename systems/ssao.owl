    <rdfs:label xml:lang="en">has_Eccentric_Anomaly</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">has Eccentric Anomaly value</ns1:Alternative_Label>
    <ns1:IRI_UUID_Shortname xml:lang="en">d40afec9_88cd_424b_9e73_7427dd6c5a47</ns1:IRI_UUID_Shortname>
  </rdf:Description>
