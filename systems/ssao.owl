  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Environment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">Space Environment</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Astronomical Space Environment</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Outer space Environment</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Space Domain</ns1:Alternative_Label>
    <ns1:Description_of_Class xml:lang="en">This is a class intended to capture the astronomical environment, or the microgravity environment of outer space. Parts or portions of this environment may be characterized as subclasses, such as Near-Space Environment, and Orbital Space Environment. These subclasses would be relative or relational with respect to a celestial object or the reference body (such as a planet), or in reference to an agent such as an observer (person or sensor).</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Resident_Space_Object">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Object"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">a space object residing in orbit (aobut Earth or another celestial body).
a space object in orbit (about Earth or another celestial body).
a space object orbiting another object
a space object in orbital motion around another object</dc:description>
    <rdfs:label xml:lang="en">Resident Space Object</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">RSO</ns1:Alternative_Label>
    <ns1:Description_of_Class xml:lang="en">This class is intended to represent human-made object in orbit.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Although some in the SSA community use the term 'resident space object' to denote artificial objects in space, there is nothing in the term that indicates the artificiality, just like there is none in 'space object'. A more accurate term would be 'Artificial resident space object'.</ns1:Development_Status_Note>
  </rdf:Description>
