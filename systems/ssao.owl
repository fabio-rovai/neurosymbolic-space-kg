  <rdf:Description rdf:about="https://purl.org/space-ontology/Reference_Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">Reference Entity</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">This is a tentative class grouping geometric, abstract, and/or physical constructs that serve as references for some other, or that use some entity as a reference. 

For example, a coordinate system is an abstract mathematical construct that is often projected onto a material object such as the Earth for the purpose of identifying the relative position of nearby objects.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development.</ns1:Development_Status_Note>
  </rdf:Description>
