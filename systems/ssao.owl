    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Asteroid</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/18th_SPCS">
