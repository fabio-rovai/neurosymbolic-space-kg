  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Launch_Mass_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has launch mass value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Probe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An unmanned instrumented spacecraft designed to gather data.</dc:description>
    <rdfs:label xml:lang="en">Space Probe</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Artificial_Space_Object"/>
    <dc:description xml:lang="en">A spacecraft is a craft designed to operate in the outer space environment.
A spacecraft is a craft designed to operate in the microgravity environment.

A spacecraft is an artifact designed to operate in outer space.
A spacecraft is an artifact designed to operate in the microgravity environment.</dc:description>
    <rdfs:label xml:lang="en">spacecraft</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Astronautical Craft</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development. 
Disambiguate. Structure hierarchy.
Various categorizations and definitions are being consider for this portion of the ontology.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Mission_Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:comment xml:lang="en">A grouping the divisons (or segments) of a mission.</rdfs:comment>
    <rdfs:label xml:lang="en">Space Mission Segment</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">This is a tentative class for the parts or divisions of a space mission.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Path">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A path through space or space-time that an object describes in its motion around another. The spatial path an object traces or follows in orbit about a celestial body or center of gravity. The spaital or spatio-temporal path an object in orbital motion traverses.</dc:description>
    <rdfs:label xml:lang="en">Orbital Path</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Development ongoing.
A category whose instances may be the particular spatial extent or spatio-temporal region traced, followed or occupied by an object in orbt over a particular period of time.</ns1:Development_Status_Note>
  </rdf:Description>
