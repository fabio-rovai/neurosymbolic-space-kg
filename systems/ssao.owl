  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_Identifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Identifier"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">spacecraft identifier</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">This class is intended to categorize the various kinds of identifiers for spacecraft distinguished according to the organization, databse, or agent assigning the identifiers. Distinct countries and organizations tracking spacecraft may assign distinct identifiers to the same spacecraft. The NORAD Catalog number is an example. This generic class can serve as a backbone to facilitate interoperability.
A separate class would need to be for objects that are not spacecraft.</ns1:Description_of_Class>
  </rdf:Description>
