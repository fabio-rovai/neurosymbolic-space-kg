    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has Timestamp value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Launch_Vehicle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Launch_Segment"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Launch Vehicle</rdfs:label>
    <ns1:Natural_Language_Definition_of_Label xml:lang="en">A vehicle or aerospace vehicle used to launch a spacecraft into the space environment.</ns1:Natural_Language_Definition_of_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Object_Tracking_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Process"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The process or activity of tracking (or following the position) of a space object over time</dc:description>
    <rdfs:label xml:lang="en">Space Object Tracking Process</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Consider modeling tracking as a state as well.
A 'Tracking State' class may signify a activity with persistent characterisitcs  (properties) over a period of itm. For example, a sensor can be described as being in state, Tracking.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Debris_Field">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Debris"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">Orbital Debris Field</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Russian_SSS">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dc:description xml:lang="en">Russia's Space Surveillance System (SSS)</dc:description>
    <rdfs:label xml:lang="en">Russian Space Surveillance System</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Mission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <rdfs:label xml:lang="en">Space Mission</rdfs:label>
    <rdfs:seeAlso xml:lang="en">Robert Rovetto's Space Mission Ontology.
https://github.com/rrovetto/Space-Mission-Ontology</rdfs:seeAlso>
    <skos:altLabel xml:lang="en">space mission</skos:altLabel>
    <ns1:Alternative_Label xml:lang="en">Astronautical Mission</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Spaceflight Mission</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development.

As an activity or a temporally-extended entity, Space Missions (or Spaceflight Mission, or Astronautical Mission) is an activity in which at least one spacecraft engages, partcipates, enacts, etc.

Missions can have phases such as preparation phases, launch phase, orbit insertion phase, orbital phase, coasting phase, deorbiting phase,  landing phase, etc. Each phase may, in turn, involve or consist of activities enacted by specific actors (spacecraft, astronauts, etc.)</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Siderial_Period">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
