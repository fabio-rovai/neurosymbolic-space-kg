  <rdf:Description rdf:about="https://purl.org/space-ontology/SSA_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An activity performed by a space situational awareness (SSA) network or SSA actor</dc:description>
    <dc:description xml:lang="en">SSA includes data collection, data storage (for cataloging objects), and data processing (for predicting motion) from observations of object in outer space (orbital space and deep space environments).</dc:description>
    <rdfs:label xml:lang="en">SSA Process</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">SSA Process</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">A tentative class for grouping kinds processes relevant or essential to SSA.</ns1:Development_Status_Note>
  </rdf:Description>
