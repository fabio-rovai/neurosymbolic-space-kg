  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Station">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A space station is distinguished from other spacecraft in that it typically does not have a means of propulsion, aside perhaps from maneuivering thrusters or other means of station-keeping. In other words, it is not typically designed for self-propelled travel.</dc:description>
    <dc:description xml:lang="en">A spacecraft designed for human occupacy over extended periods of time.</dc:description>
    <rdfs:label xml:lang="en">Space Station</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Astronautical Station</ns1:Alternative_Label>
  </rdf:Description>
