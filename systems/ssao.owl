    <rdfs:comment xml:lang="en">Thie is a class is intended to represent orbits that are elliptical, i.e., that have a orbital eccentricity value greater than 0 but less than 1.</rdfs:comment>
    <rdfs:label xml:lang="en">elliptical orbit</rdfs:label>
  </rdf:Description>
