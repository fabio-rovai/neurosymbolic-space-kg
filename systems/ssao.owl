    <ns1:Alternative_Label xml:lang="en">Natural Space Object</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">This, and similar terms, may be equivalent to the IVOA vocabulary.</ns1:Development_Status_Note>
    <ns1:Development_Status_Note xml:lang="en">Various definitions and categorizations are being consider for this portion of the ontology. Further research and concept development is needed.</ns1:Development_Status_Note>
    <ns1:Example xml:lang="en">astronomical object</ns1:Example>
    <ns1:Example xml:lang="en">the Earth</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/SSA_Network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A SSA Network is an artificial network whose purpose or function is to achieve or maintain space situational awareness (SSA), and whose parts include sensors, facilities, communications channels, etc.</dc:description>
    <dc:description xml:lang="en">SSA Networks are often composed of ground and space-based sensors, control stations, and other aspects.</dc:description>
    <rdfs:label xml:lang="en">SSA Network</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Space Situatuonal Awareness Network</ns1:Alternative_Label>
  </rdf:Description>
