  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Satellite_Name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has satellite name value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_OperationalStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A relationship between a spacecraft and its operational status.</dc:description>
    <rdfs:comment xml:lang="en">The operational status of a spacecraft may be: Active, Inactive, Damaged, Opeartional, Inoperative, Defunct, Derelict, etc.</rdfs:comment>
    <rdfs:label xml:lang="en">has operational status</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/SSA_Data">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">Data use to attain space situational awareness, or data about entities in orbit. 
Ground and space based sensors receive signals from objects in orbit. Those signals are recorded and collected as data, which is processed in order to track, identify and predict the future position of the object.</dc:description>
    <rdfs:label xml:lang="en">SSA Data</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">This is a temporary class for grouping data that may be unique to the SSA domain. 
Further development needed for this and related parts of the hierarchy.</ns1:Development_Status_Note>
    <ns1:Example xml:lang="en">A TLE set</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Military_Space_Situational_Awareness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Situational_Awareness"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Military Space Situational Awareness</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Cataloging_Activity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Process"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The activity of cataloging or electronically collecting data on detected orbital objects.</dc:description>
    <rdfs:label xml:lang="en">cataloging activity</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Primary_Satellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbit_Determination_Concept"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The term 'primary satellite' typically signifies the object of interest (or focus) in conjunction assessment. Secondary satellites are objects in relative motion to the primary, and which may collide with the primary.

The concept of a primary (or secondary) satellite in activities, such as conjunction assessment, can be modeled as roles played by a physical object in orbit. 

These concepts reflect a relative aspect, but does not reflect any objective aspect of the objects (e.g., a spacecraft) in question. An object is primary relative to the observer and their activity of assessing its likelihood of colliding with other objects.

Similarly, 'primary body' in celestial mechanics typically refers to the celestial body, in an orbital system, with the largest mass.</dc:description>
    <rdfs:label xml:lang="en">primary satellite</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Primary Object</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Conjunction_Data_Message">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Message"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label>Conjunction Data Message (CDM)</rdfs:label>
    <ns1:Alternative_Label>CDM</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Spacecraft_Name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
