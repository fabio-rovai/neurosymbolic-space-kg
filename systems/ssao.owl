  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Collision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbital_Event"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A collision between two or more objects in a gravitational orbit.
A conjunction event is often described as when the relative separation between objects reaches a specified point of closest approach.</dc:description>
    <rdfs:label xml:lang="en">Orbital Collision</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Conjunction</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Conjunction Event</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Orbital Collision Event</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Orbital Conjunction</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">Orbital Conjunction Event</ns1:Alternative_Label>
  </rdf:Description>
