  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Alternative_Label">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An annotation providing an synonymous label (e.g., name) for the ontology construct in question. It is a synonymous term for the preferred label (the display label). For example, synonyms in other languages can be listed as alternative labels.</dc:description>
    <rdfs:comment xml:lang="en">May be similar, if not equivalent to, skos:altLabel</rdfs:comment>
    <rdfs:label xml:lang="en">Alternative Label</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Longitude_of_the_Ascending_Node">
