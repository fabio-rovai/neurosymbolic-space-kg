  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb120">
    <rdfs:comment xml:lang="en">This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_Inclination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Classical_Keplerian_Orbital_Element"/>
    <dc:creator xml:lang="en">Robert J. Rovetto</dc:creator>
    <dc:description xml:lang="en">Orbital inclination describes the tilt of the orbital plane.
It defines the orientation of the orbit with respect to the Earth's equator. 
Equatorial inclinations are 0 or 180 degrees.
Prograde are greater or equal to 0 but less than 90 degrees.
Polar are 90 degrees.
Retrograde are greater than 90 but less than 180 degrees.
It is represented with the symbol 'i'.</dc:description>
    <rdfs:comment xml:lang="en">This is a class intended to represent inclination of gravitaitonal orbits, or objects in orbit.</rdfs:comment>
    <rdfs:label xml:lang="en">orbital inclination</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Orbit Inclination</ns1:Alternative_Label>
  </rdf:Description>
