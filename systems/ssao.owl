    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Stellar_Body"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Star</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Data_Provider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Actor"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An agent or actor (person, group, organization, etc.) that provides to another party data for achieving SSA.</dc:description>
    <rdfs:label xml:lang="en">data provider</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Disambiguate with Data Source.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Astronautical_System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">DEFINITION: A technological system (an artificial system, or artifact) designed to operate in the microgravity environment of outerspace.</dc:description>
    <rdfs:comment xml:lang="en">This is a class (category) for the various kinds of technological systems designed to operate in the microgravity environment of astronomical space, i.e. of outer space.</rdfs:comment>
    <rdfs:label xml:lang="en">astronautical system</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Astronautical System</ns1:Alternative_Label>
    <ns1:Example xml:lang="en">The International Space Station</ns1:Example>
    <ns1:Example xml:lang="en">a spacecraft</ns1:Example>
    <ns1:Intended_Meaning_of_Ontology_Construct xml:lang="en">This ontology construct is a class (category) for the various kinds of technological systems designed to operate in the microgravity environment of astronomical space (outer space).</ns1:Intended_Meaning_of_Ontology_Construct>
    <ns1:Natural_Language_Definition_of_Label xml:lang="en">A technological system (an artificial system), or sub-system, designed to operate in the microgravity environment of outerspace.</ns1:Natural_Language_Definition_of_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Communications_Subsystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft_Subsystem"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Communications Subsystem</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Docking_Maneuver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Proximity_Operations_Maneuver"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Docking Maneuver</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Communications_Function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Function"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">The function of communicating.
The function to communicate.
A function in which communication occurs, or in which communication capability is provided.</rdfs:comment>
    <rdfs:label xml:lang="en">communications function</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Spacecraft Communications Function</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development. Disambiguate from the communications function of a spacraft from other entities. The former would necessarily depend on the presence of specific components, for example.</ns1:Development_Status_Note>
    <ns1:Example xml:lang="en">The function of a Communications Satellite is to afford communications or provide communications capability.</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbital_State_Vector">
