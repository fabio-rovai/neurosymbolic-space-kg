  <rdf:Description rdf:about="https://purl.org/space-ontology/Keplerian_Law_of_Planetary_Motion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A physical law of nature discovered by Johannes Kepler</dc:description>
    <rdfs:label xml:lang="en">Keplerian law of planetary motion</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">This is a class to represent each of Kepler's Laws of Planetary Motion. In logically formalizing these scientific principles, automated reasoning can be achieved.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">These, and other relevant scientific laws, will be formalized with logical rules and axioms to facilitate automated inference, and calculation over orbital parameter values.</ns1:Development_Status_Note>
  </rdf:Description>
