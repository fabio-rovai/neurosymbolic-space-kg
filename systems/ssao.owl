  <rdf:Description rdf:about="https://purl.org/space-ontology/Altitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Physical_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The distance, measured in meters or kilometers, from an object (such as a spacecraft) to the surface of a reference body (such as Earth).</dc:description>
    <rdfs:label xml:lang="en">Altitude</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Note: distance from the surface to the target object (e.g. satellite) vs. distance from the center of the central body to the target object. I.e., a quantiative measure of the distance from the target object to the center of the reference body.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Development_Status_Note">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">This annotation note provides the developmental status of (a) the ontology as a whole, or (b) a specific entity (construct) in the ontology, such as a class, individiual, object property, data property, annotation property, etc.. 

This annotation is primarily intended for the developer or editor, but also makes the user aware of relevant developmental details.</dc:description>
    <rdfs:label xml:lang="en">Development Status Note</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Orbital_Eccentricity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://purl.org/space-ontology/has_Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">Represents a relation linking an orbit and its eccentricity</dc:description>
    <rdfs:label xml:lang="en">has orbital eccentricity</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">has orbit eccentricity</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Under development.

Consider 'orbit' instead of 'orbital', e.g., 'has gravitational orbit eccentricity'</ns1:Development_Status_Note>
  </rdf:Description>
