    <ns1:IRI_UUID_Shortname>20e4ccc7_b893_4b19_9e3e_84209226f842</ns1:IRI_UUID_Shortname>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Data_Catalog_ID_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#rational"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has data catalog ID value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Astronautical_Vessel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Spacecraft"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">An artificial system or vessel designed for spaceflight to carry persons or payloads in outerspace.</dc:description>
    <rdfs:label xml:lang="en">Astronautical Vessel</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Apogee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://purl.org/space-ontology/has_Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has apogee</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Data_Source_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:description xml:lang="en">A relationship to show the link between a dataset (e.g. an SSA observation) and its source (e.g., a particular ground-based sensor)</dc:description>
    <rdfs:label xml:lang="en">has data source</rdfs:label>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Operational_Status_of_Spacecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The Operational Status of a spacecrft indicates whether the spacecraft is active, inactive, operational, non-operational, defunct, derelict, abandonded, etc.</dc:description>
    <rdfs:label xml:lang="en">operational status</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development. E.g., add definitions for each status.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_Position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The position of a spacecraft at a specific time.</dc:description>
    <rdfs:comment xml:lang="en">This is a class intended to capture the position, at a time, of a spacecraft.</rdfs:comment>
    <rdfs:label xml:lang="en">spacecraft position</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Develop further.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Optical_Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Artificial_Sensor"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An artificial sensor that detects the optical portion of the electromagnetic spectrum.</dc:description>
    <rdfs:label xml:lang="en">Optical Sensor</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Launch_Vehicle_Stage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Launch_Segment"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Launch Vehicle Stage</rdfs:label>
    <ns1:Clarifying_Note xml:lang="en">Part of a launch vehicle</ns1:Clarifying_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Artificial_Satellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Satellite"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A satellite created by human beings.
A satellite that was artificially created.
A satellite that was not created by natural processes.
An artifact intentionally created by persons to operate in orbit and perform one or more functions.
An engineered object orbiting another object.</dc:description>
    <rdfs:label xml:lang="en">Artificial Satellite</rdfs:label>
    <ns1:Clarifying_Note xml:lang="en">In the spaceflight community, the terms 'space object' and 'resident space object' are often used to signify artificial satellites.
For this project, the aim is to be more precise.</ns1:Clarifying_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/International_Designator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Identifier"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The International Designator is an identifier for artificial objects launched into orbit about Earth. It consists of the year of launch, a launch number for the respective year, and a further 3-digit code. 

Alternative names for this include: COSPAR ID, NSSDC ID.</dc:description>
    <rdfs:label xml:lang="en">international designator</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">COSPAR ID</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">NSSDCA ID</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Galactic_Orbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Gravitational_Orbit"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">This section of the Orbit hierarchy is intended to capture the orbits of galaxies about one another or a common barycenter.</rdfs:comment>
    <rdfs:label xml:lang="en">galactic Orbit</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Launch_Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Mission_Segment"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A spacecraft mission, and the outerspace domain in general, is often described in terms of segments: the ground segment, control segment, launch segment, space segment, user segment, etc. Each represents a grouping of sysetms, activities, and personnel that form part of, and help execute the mission or operate the SSA system.</dc:description>
    <dc:description xml:lang="en">The collection of facilities, hardware, software and human resources required to manage and control a spacecraft during launch.</dc:description>
    <rdfs:label xml:lang="en">Launch Segment</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">A tentative category representing the parts of a space mission that involves launching a spacecraft. It may be removed or replaced.</ns1:Description_of_Class>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Perigee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="https://purl.org/space-ontology/has_Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A relationship between an satellite or orbit and its perigee (a point or part of the orbit).</dc:description>
    <rdfs:label xml:lang="en">has Perigee</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="ttp://www.semanticweb.org/rrovetto/ontologies/2014/space-situational-awareness-ontology#has_RAAN">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment>'RAAN' is an acronym for 'right-ascension of the ascending node'</rdfs:comment>
    <rdfs:label xml:lang="en">has RAAN</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">has RAAN value</ns1:Alternative_Label>
    <ns1:Alternative_Label xml:lang="en">has right-ascension of the ascending node value</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/SSA_Message">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">SSA Message</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">This class is a tentative grouping of the various kinds of orbit determination and conjunction assessment notificaiton messages.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Launch_Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The relationship between a launch vehicle and the operator of that vehicle.</dc:description>
    <rdfs:label xml:lang="en">has launch operator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Mean_Motion_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has mean motion value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Low_Earth_Orbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Geocentric_Orbit"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">There are multiple definitions of 'LEO' , often with differing altitudes, but in general a Low Earth Orbit is an Earth orbit below approximately 2000 km altitude.</dc:description>
    <rdfs:comment xml:lang="en">Low Earth Orbit more precisely designates a range of possible orbits within a specified distance (e.g., up to 2000 or 5000 km) from a the Earth. For this reason, the term 'regime' may be used.</rdfs:comment>
    <rdfs:label xml:lang="en">Low Earth Orbit</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">LEO</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Range">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Physical_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">This is a class intended to capture the distance to an object.</rdfs:comment>
    <rdfs:label xml:lang="en">range</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb146">
    <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#ClassAtom"/>
    <ns2:classPredicate rdf:resource="https://purl.org/space-ontology/Gravitational_Orbit"/>
    <ns2:argument1 rdf:resource="urn:swrl:var#x"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Space_Object_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">space object contact</rdfs:label>
    <ns1:Description_of_Class xml:lang="en">A semantic annotation for those objects that are detected by an observer (sensor, space agency, nation, etc.). This class serves as a tag for objects detected in orbit, but whose identity or category of object has not been determined. Once determined, their class changes from Space Object Contact to the appropraite class, such as Spacecraft, Orbital_Debris_Object, etc.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Ongoing development.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Apogee_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#rational"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The numeric value in kilometers, quantifying the spatial distance from the center of Earth to the farthest point in the satellite orbit from Earth (Apogee).</dc:description>
    <rdfs:comment xml:lang="en">This provides a measure of the Apogee.</rdfs:comment>
    <rdfs:label xml:lang="en">has_Apogee</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">has apogee value</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Direction_of_Vernal_Equinox">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Direction of Vernal Equinox</rdfs:label>
    <ns1:IRI_UUID_Shortname>e3415f16_2b8d_46fc_bd24_335617a8abb1</ns1:IRI_UUID_Shortname>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/observes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">observes</rdfs:label>
    <ns1:Example xml:lang="en">A ground-based sensor observes a spacecraft in orbit.</ns1:Example>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/USA">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/space-ontology/Country"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The nation-state of the United States of America</dc:description>
    <rdfs:label xml:lang="en">United States of America</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">USA</ns1:Alternative_Label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Ephemeris">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbit_Data"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Ephemeris</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Spacecraft_Operator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A relationship between a spacecraft and its operator.</dc:description>
    <rdfs:label xml:lang="en">has spacecraft operator</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/is_orbited_by">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <owl:inverseOf rdf:resource="https://purl.org/space-ontology/orbits"/>
    <rdfs:domain rdf:resource="https://purl.org/space-ontology/Astronomoical_Object"/>
    <rdfs:domain rdf:resource="https://purl.org/space-ontology/Barycenter"/>
    <rdfs:range rdf:resource="https://purl.org/space-ontology/Orbital_Object"/>
    <rdfs:range rdf:resource="https://purl.org/space-ontology/Resident_Space_Object"/>
    <rdfs:range rdf:resource="https://purl.org/space-ontology/Satellite"/>
    <rdfs:range rdf:resource="https://purl.org/space-ontology/Space_Object"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">is orbited by</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/True_Anomaly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Classical_Keplerian_Orbital_Element"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">True Anomaly desribes the satellite location in orbit. 
It is the angle from perigee to the satellite's position. It defines where the satellite is within the orbit with respect to perigee (https://spaceflight.nasa.gov/realdata/elements/).
It has values greater or equal to 0 but less than 360 degrees.
It is undefined for circular orbits, i.e. when eccentricity is 0 degrees.</dc:description>
    <rdfs:label xml:lang="en">true anomaly</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_1st_time_derivative_of_mean_motion_value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has 1st time derivative of mean motion value</rdfs:label>
    <ns1:IRI_UUID_Shortname>4807d753_9a68_4ecf_ada1_af6a99eb407c</ns1:IRI_UUID_Shortname>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb49">
    <rdfs:comment xml:lang="en">This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Nadir">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Physical_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Nadir</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Orbit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator xml:lang="en">Robert J. Rovetto</dc:creator>
    <dc:description xml:lang="en">The path desribed or traced by a body revolving around another.</dc:description>
    <rdfs:label xml:lang="en">orbit</rdfs:label>
    <rdfs:seeAlso xml:lang="en">"The path described by one body in its revolution about another" (Merriam Webster's Collegiate Dictionary)</rdfs:seeAlso>
    <ns1:Description_of_Class xml:lang="en">This is a category for the various kinds of orbits, such as orbits of astronommical bodies, orbits of subatomic particles, etc.</ns1:Description_of_Class>
    <ns1:Development_Status_Note xml:lang="en">Although the intended concept to represent in this ontology is the orbits in astronomical space, i.e. gravitationally-determined orbits, the term 'orbit' is broader (e.g., the orbits of subatomic particles). One way to differentiate them is by the binding forces. Therefore it will be more precise to use 'orbit' as a catch-all term, and a more specific term for the target orbits.

The broadest concept to express is that of one thing or entity revolving around another. This covers both micro and macroscopic objects (such as spacecraft and planets), as well as centers of gravity.
Note also that dictionary definitions of 'orbit' provide various senses.

Both astronautical literature (including SSA and astronomy) and the non-specialist, often use 'orbit' to mean orbits of object in outer space. This ontology work will explore formally linking context-specific terms to more precise terms that may be asserted in the ontology.

Formal definitions, at least from a philosophical perspective, are under development by the author/ontology-creator (as of approx. 2012).</ns1:Development_Status_Note>
    <ns1:Development_Status_Note xml:lang="en">R.J.Rovetto's (the author) orbit type ontology.</ns1:Development_Status_Note>
    <ns1:Editor xml:lang="en">Robert J. Rovetto</ns1:Editor>
    <ns1:Scope xml:lang="en">Various types of orbit at various scales or granularity, from subatomic particles (i.e. particle orbits) to astronomical objects (i.e., gravitational or celestial orbits).</ns1:Scope>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/is_registered_Country_in_UN_Register_of_Space_Objects">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">is registered country in UN Register of Space Objects</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Two_Line_Element_Set">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Data_Format"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A data format encoding a set of orbital parameters to describe an orbit at a particular time. A TLE set typically consists of 2-3 lines (line 0, 1, 2) of symbols, groups of which have particular meaning. Line 0 may or may not be present but can include spacecraft name and dimensions. A TLE is generated using the Simplified General Pertubations Theory (SGPT). The two-line element set (TLE), developed by NORAD (North American Aerospace Defense Command), is the most commonly used data format.</dc:description>
    <rdfs:comment xml:lang="en">The most commonly used data format is the NORAD (North American Aerospace Defense Command) Two-line element set (TLE).</rdfs:comment>
    <rdfs:label xml:lang="en">two-line element set</rdfs:label>
    <rdfs:seeAlso xml:lang="en">https://spaceflight.nasa.gov/realdata/sightings/SSapplications/Post/JavaSSOP/SSOP_Help/tle_def.html</rdfs:seeAlso>
    <ns1:Alternative_Label xml:lang="en">TLE</ns1:Alternative_Label>
    <ns1:Development_Status_Note xml:lang="en">Instances of this class have a Data Provider and/or Data Source.</ns1:Development_Status_Note>
    <ns1:Development_Status_Note xml:lang="en">The intent for this ontology is to provide a metadata set, or a set of ontology classes and relations, that will tag and annotate the elements of the TLE and other formats.

Consider each TLE element part (e.g. Satellite Numbe) being a Data Element that is a part of the TLE class. Instances of each part as being instances of the respective class. Alternatively, a data property (relation) for each part specifying the value.</ns1:Development_Status_Note>
    <ns1:Editor xml:lang="en">Robert J. Rovetto</ns1:Editor>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Elliptical_Orbit">
