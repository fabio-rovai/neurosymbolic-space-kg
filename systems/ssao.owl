    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Reference_Entity"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">Reference Frame</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Frame of Reference</ns1:Alternative_Label>
    <ns1:Clarifying_Note xml:lang="en">Orbital parameters must be relative to a reference frame.</ns1:Clarifying_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Sensor_A">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/space-ontology/Artificial_Sensor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Position">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:comment xml:lang="en">Combined with the 'has Velocity value' relation, it provides a Cartesian Element set for a spacecraft.</rdfs:comment>
    <rdfs:label xml:lang="en">has position value</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Artificial_Sensor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Sensor"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:creator xml:lang="en">Robert John Rovetto</dc:creator>
    <dc:description xml:lang="en">A technological system (artifact) that transmits and/or receives signals (electromagnetic energy).</dc:description>
    <rdfs:comment xml:lang="en">Artificial sensors can be categorized based on the part of the electromagnetic spectrum they detect, their function, operating location, etc. The first two criteria are more stable and therefore better suited to distinguish ontological categories.</rdfs:comment>
    <rdfs:label xml:lang="en">Artificial Sensor</rdfs:label>
    <skos:altLabel xml:lang="en">sensor device</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/has_Name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <rdfs:label xml:lang="en">has name</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb119">
    <rdfs:comment xml:lang="en">This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view.</rdfs:comment>
  </rdf:Description>
