    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbital_Property"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The time required for a satellite to complete an orbit about its central body (e.g., Earth).
It's unit of measure is typically minutes.</dc:description>
    <rdfs:label xml:lang="en">Orbital Period</rdfs:label>
