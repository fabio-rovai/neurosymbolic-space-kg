    <ns1:Development_Status_Note xml:lang="en">This Data Property will provide a set of authorized string values, "Active", "Inactive", "Operational", "Inoperational", "Debris", "Defunct", "Derelict", etc.</ns1:Development_Status_Note>
  </rdf:Description>
