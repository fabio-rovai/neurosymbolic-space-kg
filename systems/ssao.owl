    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Space_Object"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A satellite is a natural or artificial object in orbital motion.
More generally, it is something that orbits something else.</dc:description>
    <rdfs:label xml:lang="en">Satellite</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Under development.</ns1:Development_Status_Note>
  </rdf:Description>
