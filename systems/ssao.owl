  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Detection_Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/SSA_Event"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">An event in which a sensor detected an object in orbit about a celestial body.</dc:description>
    <rdfs:label xml:lang="en">detection event</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na5d009298a3a4b9481c2deced7e598abb84">
    <rdfs:comment xml:lang="en">This is an entity positioning annotation generated by CoModIDE (https://comodide.com/). Removing this annotation will break rendering the CoModIDE schema diagram view.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Payload">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The cargo or contents, to be transported, of a craft or vehicle and which are not required for the operation of that vehicle.</dc:description>
    <rdfs:label xml:lang="en">Payload</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Add subclasses, e.g. Spacecraft Payload.</ns1:Development_Status_Note>
    <ns1:Development_Status_Note xml:lang="en">Payloads can be modeled as roles played by a system (e.g., spacecraft). A space system is a payload at least during it's transport (by a host vehicle) to its target orbit or destination.</ns1:Development_Status_Note>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/Spacecraft_State">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Orbit_Determination_Concept"/>
    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">The aggregate of the position and velocity of a spacecraft at a given time.

The position and velocity at a time are collectively referred to as the state of a spacecraft.</dc:description>
    <rdfs:label xml:lang="en">spacecraft state</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/space-ontology/ssao.owl/degrees">
