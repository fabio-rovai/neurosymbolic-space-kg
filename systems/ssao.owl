  <rdf:Description rdf:about="https://purl.org/space-ontology/Semi_Major_Axis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.org/space-ontology/Classical_Keplerian_Orbital_Element"/>
    <dc:creator xml:lang="en">Robert J. Rovetto</dc:creator>
    <dc:description xml:lang="en">The semi-major axis of an orbit describes the size of the orbit.
It is half the major (or longer) axis of the ellipse (elliptical orbit).
The symbol is 'a'.</dc:description>
    <rdfs:label xml:lang="en">Semi-major Axis</rdfs:label>
    <ns1:Alternative_Label xml:lang="en">Orbit Semi-major Axis</ns1:Alternative_Label>
  </rdf:Description>
