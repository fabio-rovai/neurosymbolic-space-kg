    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A vehicle designed to operate and travel in and through atmospheric and microgravity environments.

A vehicle designed for flight in both atmospheric and non-atmospheric environments.</dc:description>
    <rdfs:label xml:lang="en">aerospace vehicle</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Various definitions and categorizations are being considered for this portion of the hierarchy.</ns1:Development_Status_Note>
