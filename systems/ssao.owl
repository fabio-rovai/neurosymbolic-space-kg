    <dc:creator rdf:resource="http://orcid.org/0000-0003-3835-7817"/>
    <dc:description xml:lang="en">A physical object (e.g., planet, spacecraft, etc.) used to fix and orient a coordinate system.</dc:description>
    <rdfs:label xml:lang="en">Reference Body</rdfs:label>
    <ns1:Development_Status_Note xml:lang="en">Consider various ways to model reference entities. A reference body, for example, may be represented as a particular astronomical boy (e.g., a star) that is assigned a role or is ascribed a relative property in a particular context, where the classes of Role and RelativeProperty and Context may be asserted, formally defined, and related accordingly.</ns1:Development_Status_Note>
  </rdf:Description>
